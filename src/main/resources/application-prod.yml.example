# ==================================================================
# 운영(prod) 프로파일 템플릿
#
# 실물 application-prod.yml 은 git 에 없다. GitHub Secrets 의
# APPLICATION_PROD_YML(base64) 에 들어 있고, cd.yml 이 빌드 직전에
# src/main/resources/application-prod.yml 로 복원해 bootJar 에 넣는다.
# EC2 는 SPRING_PROFILES_ACTIVE=prod 로 컨테이너를 띄운다.
#
# 이 파일은 "어떤 키가 필요한가" 를 레포에 남기기 위한 사본이다.
# ⚠️ 여기에 실제 값을 채워 커밋하지 말 것. <...> 자리표시자로만 둔다.
#
# ------------------------------------------------------------------
# 시크릿을 만드는 정상 경로는 손으로 채우기가 아니라 infra 레포다.
#
#   cd infra
#   ( set -o pipefail
#     terraform output -raw backend_prod_yml | tr -d '\r' | base64 -w0 > /tmp/prod.b64 ) \
#     && test -s /tmp/prod.b64 \
#     && gh secret set APPLICATION_PROD_YML --repo HACK-rookies32/backend < /tmp/prod.b64
#   rm -f /tmp/prod.b64
#
# 한 줄 파이프로 이어 붙이지 말 것. state 가 비어 있으면 terraform output 이
# 실패하지만, pipefail 이 없으면 base64 가 빈 문자열을 성공으로 넘기고 gh 가
# 그 빈 값을 등록하며 성공 메시지까지 찍는다. cd.yml 이 -z 로 막아 주긴 하나
# 그때는 이미 배포가 죽은 뒤다.
#
# 엔드포인트를 사람이 옮겨 적으면 RDS 를 다시 만들 때부터 조용히 낡는다.
# 이 파일은 그 output(infra/outputs.tf 의 backend_prod_yml)과 같은 내용이며,
# 한쪽을 고치면 다른 쪽도 같이 고쳐야 한다.
# ------------------------------------------------------------------
#
# ------------------------------------------------------------------
# 값을 나누는 기준
#
#   이 파일(=이미지 안에 구워짐) : 엔드포인트, 계정명, 드라이버, 스위치
#   app.env(=SSM 에서 부팅 시 주입) : 비밀번호 / 토큰 / 서명키
#
# 비밀번호를 이미지에 굽지 않는 이유는 롤백이다. cd.yml 은 sha- 태그를
# 남겨 두고 그 이미지로 되돌리므로, 비밀번호가 이미지에 있으면 교체를 해도
# 옛 태그 안에 예전 비밀번호가 영구히 남는다. 그러면 Docker Hub 이미지를
# pull 할 수 있는 사람 = DB 에 붙을 수 있는 사람이 된다.
# 반대로 엔드포인트/계정명은 프라이빗 서브넷(rds_sg 가 was_sg 만 허용)이라
# 새어도 접속이 되지 않으므로 이미지에 있어도 된다.
#
# 아래 ${...} 는 전부 app.env 가 채운다. 비어 있으면 플레이스홀더 해석에
# 실패해 앱이 기동하지 못한다 — 조용히 로컬 설정으로 떨어지는 것보다 낫다.
# ==================================================================
spring:
  # ----------------------------------------------------------------
  # RDS Oracle (infra/database.tf: aws_db_instance.oracle)
  #
  # <RDS_ENDPOINT> 는 `terraform output rds_endpoint` 값이며 이미 :1521 을
  # 포함한다. 뒤의 ORCL 은 SID(var.oracle_db_name)이고 어긋나면 ORA-12514 다.
  #
  # 전송 암호화는 옵션그룹의 NNE 로 걸려 있고 Oracle thin 드라이버가 자동
  # 협상하므로 URL 에 따로 붙일 것이 없다.
  # ----------------------------------------------------------------
  datasource:
    url: jdbc:oracle:thin:@//<RDS_ENDPOINT>/ORCL
    username: <DB_USERNAME>
    password: ${SPRING_DATASOURCE_PASSWORD}
    driver-class-name: oracle.jdbc.OracleDriver

  jpa:
    database-platform: org.hibernate.dialect.OracleDialect
    hibernate:
      # ⚠️ 운영 스키마에 자동 DDL 을 치지 않는다.
      #    최초 1 회만 테이블을 만들어야 하므로, 첫 배포 때는 app.env 에
      #      SPRING_JPA_HIBERNATE_DDL_AUTO=update
      #    를 넣어 한 번 띄운 뒤(테이블 생성 확인) 그 줄을 지우고 재기동한다.
      #    이후에는 엔티티와 스키마가 어긋나면 기동 시점에 바로 잡힌다.
      ddl-auto: validate
    # 쿼리 로그가 stdout 으로 다 나가면 컨테이너 로그가 폭증한다.
    # (호스트 쪽 json-file 로테이션은 10m x 3 뿐이다)
    show-sql: false

  # 운영에 H2 콘솔이 열려 있을 이유가 없다.
  # SecurityConfig 가 anyRequest().permitAll() 이라 더더욱 닫아야 한다.
  h2:
    console:
      enabled: false

  data:
    # DocumentDB. URI 에 비밀번호가 박히는 구조라 통째로 app.env 에서 받는다.
    # (retryWrites=false, replicaSet=rs0 필수 — 인프라 쪽 주석 참고)
    mongodb:
      uri: ${SPRING_DATA_MONGODB_URI}

    # ElastiCache Redis. transit_encryption_enabled = true 이므로
    # ssl.enabled 를 켜지 않으면 접속 자체가 실패한다.
    redis:
      host: <REDIS_PRIMARY_ENDPOINT>
      port: 6379
      ssl:
        enabled: true

# ALB -> Nginx -> NLB -> WAS 로 프록시가 2 단이다. 이 값이 없으면 Spring 이
# X-Forwarded-Proto 를 무시해 절대 URL/리다이렉트가 http:// 로 생성된다.
server:
  forward-headers-strategy: framework

jwt:
  secret: ${JWT_SECRET}
  expiration: 3600000

# WAS 부팅 스크립트가 SSM 에서 받아 컨테이너에 읽기 전용으로 마운트한다.
#
# ⚠️ 클래스패스가 아니라 파일시스템 경로이므로 file: 접두사가 반드시 필요하다.
#    빠지면 PushConfig 가 jar 안에서 찾다가 실패하고, prod 는 기동을 거부한다.
firebase:
  credentials-path: file:/run/secrets/firebase.json

# 버킷 이름이 비면 앱이 조용히 로컬 디스크 모드로 떨어진다(첨부파일이
# 컨테이너 교체 때마다 사라지고 WAS 2 대가 서로의 파일을 못 본다).
# infra/variables.tf 의 var.s3_bucket_name 과 반드시 일치시킬 것.
app:
  s3:
    bucket: <S3_BUCKET_NAME>
    prefix: uploads
    presign-ttl: 5m

  # ⚠️ 이 줄이 없으면 기본값 mock 이 그대로 남아 운영에서도 푸시가 로그로만 남는다.
  #    반대로 firebase 로 켠 뒤 SSM 에 키가 없으면 컨테이너가 뜨지 않는다(의도된 동작).
  #    → 키를 SSM 에 먼저 넣고, 그다음 이 시크릿을 갱신할 것.
  push:
    provider: firebase
